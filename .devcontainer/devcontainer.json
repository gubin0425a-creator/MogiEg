{
  "name": "MogiEgg (GitHub Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postStartCommand": "python server.py",
  "portsAttributes": {
    "8501": {
      "label": "MogiEgg Studio Web App",
      "onAutoForward": "openBrowser"
    }
